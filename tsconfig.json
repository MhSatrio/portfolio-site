{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["api/**/*.ts", "services/**/*.ts", "types/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "src/**/*.ts", "admin-src/**/*.ts"]
}
