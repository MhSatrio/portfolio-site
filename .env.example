# Google Service Account (Sheets API) — from the JSON key file, never commit real values.
GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_EMAIL=
# Keep the literal \n sequences from the JSON key's private_key field.
GOOGLE_PRIVATE_KEY=
# Spreadsheet ID from its URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=

# Admin dashboard (/admin) password.
ADMIN_PASSWORD=

# Gmail SMTP for the single "new session" notification email.
# EMAIL_PROVIDER=gmail
# EMAIL_USERNAME=you@gmail.com
# EMAIL_PASSWORD=your-16-char-gmail-app-password
EMAIL_PROVIDER=gmail
EMAIL_USERNAME=
EMAIL_PASSWORD=
